# CoverageX Vehicle Signal Graph — environment template
# Copy to config/.env and fill in real values. NEVER commit config/.env.
# config/.env is gitignored; this .example file (names only) is safe to commit.

# Apify — collection engine (dealer discovery + dynamic inventory pages). Phase 1.
APIFY_TOKEN=

# NHTSA vPIC + recalls base (public, no key required)
NHTSA_API_BASE=https://vpic.nhtsa.dot.gov/api

# Apollo — OPTIONAL, B2B partner contacts ONLY, NOT used in Phase 1
APOLLO_API_KEY=

# Optional: defaults to local SQLite at data/vehicle_signal_graph.sqlite
DATABASE_URL=
